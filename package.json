{
  "name": "navigation-stack",
  "version": "0.6.13",
  "description": "Navigation in a Single-Page Application",
  "keywords": [
    "history",
    "browser",
    "navigation",
    "router",
    "routing"
  ],
  "homepage": "https://gitlab.com/catamphetamine/navigation-stack#readme",
  "bugs": {
    "url": "https://gitlab.com/catamphetamine/navigation-stack/issues"
  },
  "license": "MIT",
  "author": "catamphetamine",
  "type": "module",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./types/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/catamphetamine/navigation-stack.git"
  },
  "scripts": {
    "build": "npm-run-all build:clean build:transpile build:bundle",
    "build:clean": "rimraf lib bundle",
    "build:transpile": "babel src --out-dir lib",
    "build:bundle": "esbuild lib/index.js --bundle --minify --sourcemap --format=iife --global-name=NavigationStackExports --outfile=bundle/navigation-stack.js",
    "test": "npm-run-all install-browsers-for-tests test-in-browser",
    "test-in-console": "mocha --bail \"source/**/*.test.js\" \"test/*.test.js\" \"test/!(exports)/**/*.test.js\"",
    "test-in-browser": "web-test-runner test/**/*.test.js !test/exports/**/*.test.js --node-resolve --playwright --browsers chromium firefox --concurrency 1 --debug",
    "test-exports": "mocha --bail \"test/exports/**/*.test.js\"",
    "install-browsers-for-tests": "playwright install",
    "prepublishOnly": "npm run test build test-exports"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-playwright": "^0.11.1",
    "chai": "^6.2.2",
    "cross-env": "^10.1.0",
    "delay": "^7.0.0",
    "dom-helpers": "^6.0.1",
    "esbuild": "^0.28.0",
    "mocha": "^11.7.5",
    "npm-run-all": "^4.1.5",
    "p-defer": "^4.0.1",
    "rimraf": "^6.1.3",
    "sinon": "^22.0.0"
  }
}
